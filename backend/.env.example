# ==========================================
# VakCare Platform - Environment Variables
# Copy this file to .env and customize values
# ==========================================

# Core Django Settings
DJANGO_SECRET_KEY=change-in-production-to-a-very-long-random-string-at-least-50-chars
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=vakcare_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Test Configuration
# When set to True, pytest uses an isolated in-memory/file SQLite database for local development tests.
# Set to False to run automated tests against the configured PostgreSQL instance.
USE_SQLITE_FOR_TESTS=True

# Security & CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Application Timezone
TIME_ZONE=Asia/Kolkata

# AI Assistant Service Foundation
# Options: 'mock' (default, offline & deterministic), 'openai', or 'gemini'
AI_PROVIDER=openai
# Leave empty for mock fallback, or provide your OpenAI/Gemini API key
AI_PROVIDER_API_KEY=your_openai_or_gemini_api_key_here
# Model choice (e.g. gpt-4o-mini, gpt-4o for OpenAI, or gemini-2.5-flash for Google)
AI_PROVIDER_MODEL=gpt-4o-mini
AI_RATE_LIMIT=30/minute


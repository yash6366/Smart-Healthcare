# ====================================================================
# VakCare Healthcare Platform - Environment Variables Template
# Copy this file to .env (or .env.local) and customize for your environment.
# Never commit credentials or secret keys to version control.
# ====================================================================

# Core Django Settings
DJANGO_SECRET_KEY=change-in-production-to-a-very-long-random-string-at-least-50-chars
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.vercel.app

# ====================================================================
# Database Environment Selector: 'local' (default) or 'aiven'
# ====================================================================
DB_ENVIRONMENT=local

# --------------------------------------------------------------------
# 1. Local MySQL Configuration (Active when DB_ENVIRONMENT=local)
# --------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=vakcare_db
DB_USER=vakcare_dev
DB_PASSWORD=your_local_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=60

# --------------------------------------------------------------------
# 2. Aiven Cloud MySQL Configuration (Active when DB_ENVIRONMENT=aiven)
# --------------------------------------------------------------------
AIVEN_DATABASE_URL=mysql://<username>:<password>@<aiven-host>:12289/defaultdb?ssl-mode=REQUIRED
AIVEN_DB_ENGINE=django.db.backends.mysql
AIVEN_DB_NAME=defaultdb
AIVEN_DB_USER=<aiven-username>
AIVEN_DB_PASSWORD=<aiven-password>
AIVEN_DB_HOST=<aiven-host>.aivencloud.com
AIVEN_DB_PORT=12289
AIVEN_DB_SSL_REQUIRE=True
AIVEN_DB_CONN_MAX_AGE=0

# Test Configuration
# When set to True, pytest uses an isolated SQLite database for unit tests.
USE_SQLITE_FOR_TESTS=True

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,https://*.vercel.app

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

TIME_ZONE=Asia/Kolkata

# AI Assistant Provider: Options: 'mock', 'openai', or 'gemini'
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=your_gemini_or_openai_api_key_here
AI_PROVIDER_MODEL=gemini-2.5-flash

# API Throttling
THROTTLE_AUTH=300/minute
THROTTLE_AI=60/minute
